<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau データビジュアライゼーション ギャラリー</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&display=swap');
        
        :root {
            --sakura-pink: #FFB7C5;
            --soft-pink: #F8E8EA;
            --deep-pink: #E85A8C;
            --cream: #FFF5F5;
            --charcoal: #333333;
            --light-gray: #F5F5F5;
            --gold: #D4AF37;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Noto Sans JP', sans-serif;
            background: linear-gradient(135deg, var(--cream) 0%, var(--soft-pink) 100%);
            color: var(--charcoal);
            line-height: 1.6;
        }

        /* 桜の花びらアニメーション */
        .sakura-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: -1;
            opacity: 0.1;
        }

        .sakura {
            position: absolute;
            width: 10px;
            height: 10px;
            background: var(--sakura-pink);
            border-radius: 50% 0 50% 0;
            animation: fall 10s infinite linear;
        }

        @keyframes fall {
            0% {
                transform: translateY(-100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotate(360deg);
                opacity: 0;
            }
        }

        header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 2rem 0;
            text-align: center;
            border-bottom: 3px solid var(--sakura-pink);
            position: relative;
        }

        .header-decoration {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(255, 183, 197, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            z-index: -1;
        }

        h1 {
            font-size: 2.5rem;
            color: var(--deep-pink);
            margin-bottom: 0.5rem;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.1);
            font-weight: 500;
        }

        .subtitle {
            font-size: 1.1rem;
            color: var(--charcoal);
            opacity: 0.8;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .dashboard-card {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 8px 32px rgba(232, 90, 140, 0.1);
            border: 1px solid rgba(255, 183, 197, 0.3);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .dashboard-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100px;
            height: 100px;
            background: radial-gradient(circle, var(--sakura-pink), transparent);
            opacity: 0.1;
            border-radius: 50%;
        }

        .dashboard-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(232, 90, 140, 0.2);
            border-color: var(--sakura-pink);
        }

        .card-header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .card-title {
            font-size: 1.3rem;
            color: var(--deep-pink);
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .card-description {
            color: var(--charcoal);
            opacity: 0.8;
            font-size: 0.9rem;
        }

        .tableau-container {
            width: 100%;
            height: 400px;
            border-radius: 15px;
            overflow: hidden;
            background: var(--light-gray);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px dashed var(--sakura-pink);
            margin: 1rem 0;
            position: relative;
        }

        .tableau-placeholder {
            text-align: center;
            color: var(--deep-pink);
            font-size: 0.9rem;
        }

        .update-info {
            background: linear-gradient(45deg, var(--soft-pink), var(--cream));
            padding: 1.5rem;
            border-radius: 15px;
            margin-top: 3rem;
            border-left: 5px solid var(--deep-pink);
        }

        .update-title {
            color: var(--deep-pink);
            font-weight: 500;
            margin-bottom: 1rem;
        }

        .update-steps {
            color: var(--charcoal);
            font-size: 0.9rem;
        }

        .update-steps li {
            margin-bottom: 0.5rem;
        }

        footer {
            text-align: center;
            padding: 2rem;
            margin-top: 3rem;
            background: rgba(255, 255, 255, 0.5);
            border-top: 1px solid rgba(255, 183, 197, 0.3);
            color: var(--charcoal);
            opacity: 0.8;
        }

        .japanese-pattern {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 30px;
            height: 30px;
            background: repeating-linear-gradient(
                45deg,
                var(--sakura-pink),
                var(--sakura-pink) 2px,
                transparent 2px,
                transparent 8px
            );
            opacity: 0.3;
            border-radius: 5px;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2rem;
            }
            
            .gallery-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            
            .container {
                padding: 1rem;
            }
            
            .tableau-container {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <!-- 桜の花びら背景 -->
    <div class="sakura-bg">
        <div class="sakura" style="left: 10%; animation-delay: 0s;"></div>
        <div class="sakura" style="left: 20%; animation-delay: 1s;"></div>
        <div class="sakura" style="left: 30%; animation-delay: 2s;"></div>
        <div class="sakura" style="left: 40%; animation-delay: 3s;"></div>
        <div class="sakura" style="left: 50%; animation-delay: 4s;"></div>
        <div class="sakura" style="left: 60%; animation-delay: 5s;"></div>
        <div class="sakura" style="left: 70%; animation-delay: 6s;"></div>
        <div class="sakura" style="left: 80%; animation-delay: 7s;"></div>
        <div class="sakura" style="left: 90%; animation-delay: 8s;"></div>
    </div>

    <header>
        <div class="header-decoration"></div>
        <h1>Tableau ダッシュボード ギャラリー</h1>
        <p class="subtitle">美しいデータビジュアライゼーションの世界へようこそ</p>
    </header>

    <div class="container">
        <div class="gallery-grid">
            <!-- ダッシュボード カード 1 -->
            <div class="dashboard-card">
                <div class="japanese-pattern"></div>
                <div class="card-header">
                    <h3 class="card-title">売上分析ダッシュボード</h3>
                    <p class="card-description">月別・地域別の売上動向を美しく可視化</p>
                </div>
                <div class="tableau-container">
                    <div class="tableau-placeholder">
                        <p>🌸 Tableau埋め込みコードをここに配置 🌸</p>
                        <small>例：&lt;div class='tableauPlaceholder'&gt;...&lt;/div&gt;</small>
                    </div>
                </div>
            </div>

            <!-- ダッシュボード カード 2 -->
            <div class="dashboard-card">
                <div class="japanese-pattern"></div>
                <div class="card-header">
                    <h3 class="card-title">顧客分析レポート</h3>
                    <p class="card-description">顧客セグメント別の行動パターンを分析</p>
                </div>
                <div class="tableau-container">
                    <div class="tableau-placeholder">
                        <p>🌸 Tableau埋め込みコードをここに配置 🌸</p>
                        <small>例：&lt;div class='tableauPlaceholder'&gt;...&lt;/div&gt;</small>
                    </div>
                </div>
            </div>

            <!-- ダッシュボード カード 3 -->
            <div class="dashboard-card">
                <div class="japanese-pattern"></div>
                <div class="card-header">
                    <h3 class="card-title">在庫管理ダッシュボード</h3>
                    <p class="card-description">リアルタイムの在庫状況と予測分析</p>
                </div>
                <div class="tableau-container">
                    <div class="tableau-placeholder">
                        <p>🌸 Tableau埋め込みコードをここに配置 🌸</p>
                        <small>例：&lt;div class='tableauPlaceholder'&gt;...&lt;/div&gt;</small>
                    </div>
                </div>
            </div>

            <!-- ダッシュボード カード 4 -->
            <div class="dashboard-card">
                <div class="japanese-pattern"></div>
                <div class="card-header">
                    <h3 class="card-title">マーケティング効果測定</h3>
                    <p class="card-description">キャンペーン効果とROIを総合評価</p>
                </div>
                <div class="tableau-container">
                    <div class="tableau-placeholder">
                        <p>🌸 Tableau埋め込みコードをここに配置 🌸</p>
                        <small>例：&lt;div class='tableauPlaceholder'&gt;...&lt;/div&gt;</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 更新方法の説明 -->
        <div class="update-info">
            <h3 class="update-title">📝 ダッシュボードの更新方法</h3>
            <div class="update-steps">
                <ol>
                    <li>Tableau Publicで新しいダッシュボードを公開します</li>
                    <li>「共有」→「埋め込みコード」から埋め込み用HTMLを取得します</li>
                    <li>上記の「Tableau埋め込みコードをここに配置」部分を埋め込みコードで置き換えます</li>
                    <li>カードのタイトルと説明も適宜更新してください</li>
                    <li>新しいダッシュボードを追加する場合は、既存のカードをコピーして内容を変更します</li>
                </ol>
                <p style="margin-top: 1rem; font-style: italic; color: var(--deep-pink);">
                    ※ このテンプレートはレスポンシブ対応で、どのデバイスでも美しく表示されます
                </p>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2025 Tableau ダッシュボード ギャラリー | データで未来を描く</p>
    </footer>

    <script>
        // 桜の花びらを動的に生成
        function createSakura() {
            const sakuraBg = document.querySelector('.sakura-bg');
            const sakura = document.createElement('div');
            sakura.className = 'sakura';
            sakura.style.left = Math.random() * 100 + '%';
            sakura.style.animationDuration = (Math.random() * 3 + 7) + 's';
            sakura.style.opacity = Math.random() * 0.3 + 0.1;
            sakuraBg.appendChild(sakura);

            // 花びらを削除（メモリリーク防止）
            setTimeout(() => {
                sakura.remove();
            }, 10000);
        }

        // 2秒ごとに新しい花びらを追加
        setInterval(createSakura, 2000);

        // カードのホバーエフェクトを強化
        document.querySelectorAll('.dashboard-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-10px) scale(1.02)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });
    </script>
</body>
</html>
