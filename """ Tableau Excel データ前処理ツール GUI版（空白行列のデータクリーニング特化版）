        preview_frame = ttk.LabelFrame(dialog, text="プレビュー", padding="10")
        preview_frame.pack(fill=tk.BOTH, expand=True, padx=20, pady=10)
        
        preview_text = tk.Text(preview_frame, height=8, font=('Consolas', 9))
        preview_text.pack(fill=tk.BOTH, expand=True)
        
        def update_preview():
            try:
                col = column_var.get()
                condition = condition_var.get()
                value = value_var.get()
                
                if not col or not value:
                    preview_text.delete(1.0, tk.END)
                    preview_text.insert(1.0, "列名と値を入力してください。")
                    return
                
                # フィルタ適用
                if condition == "contains":
                    filtered_data = self.data[self.data[col].astype(str).str.contains(value, case=False, na=False)]
                elif condition == "equals":
                    filtered_data = self.data[self.data[col].astype(str) == value]
                elif condition == "starts_with":
                    filtered_data = self.data[self.data[col].astype(str).str.startswith(value, na=False)]
                elif condition == "ends_with":
                    filtered_data = self.data[self.data[col].astype(str).str.endswith(value, na=False)]
                elif condition == "not_contains":
                    filtered_data = self.data[~self.data[col].astype(str).str.contains(value, case=False, na=False)]
                
                preview_info = f"フィルタ結果: {len(filtered_data):,} 行 / {len(self.data):,} 行中\n\n"
                preview_info += "最初の5行:\n"
                preview_info += filtered_data.head().to_string()
                
                preview_text.delete(1.0, tk.END)
                preview_text.insert(1.0, preview_info)
                
            except Exception as e:
                preview_text.delete(1.0, tk.END)
                preview_text.insert(1.0, f"エラー: {str(e)}")
        
        # イベントバインド
        for widget in [column_combo, condition_combo, value_entry]:
            widget.bind('<KeyRelease>', lambda e: update_preview())
            widget.bind('<<ComboboxSelected>>', lambda e: update_preview())
        
        # ボタン
        button_frame = ttk.Frame(dialog)
        button_frame.pack(pady=20)
        
        def apply_filter():
            try:
                col = column_var.get()
                condition = condition_var.get()
                value = value_var.get()
                
                if not col or not value:
                    messagebox.showwarning("警告", "列名と値を入力してください。")
                    return
                
                initial_rows = len(self.data)
                
                # フィルタ適用
                if condition == "contains":
                    self.data = self.data[self.data[col].astype(str).str.contains(value, case=False, na=False)]
                elif condition == "equals":
                    self.data = self.data[self.data[col].astype(str) == value]
                elif condition == "starts_with":
                    self.data = self.data[self.data[col].astype(str).str.startswith(value, na=False)]
                elif condition == "ends_with":
                    self.data = self.data[self.data[col].astype(str).str.endswith(value, na=False)]
                elif condition == "not_contains":
                    self.data = self.data[~self.data[col].astype(str).str.contains(value, case=False, na=False)]
                
                final_rows = len(self.data)
                filtered_rows = initial_rows - final_rows
                
                self.update_data_info()
                self.update_data_table()
                
                self.log_action(f"データフィルタ: {col} {condition} '{value}' ({filtered_rows}行削除)")
                self.update_status(f"✅ フィルタ適用完了 ({final_rows}行残存)")
                
                messagebox.showinfo("完了", f"フィルタ適用完了\n{initial_rows:,} → {final_rows:,} 行")
                dialog.destroy()
                
            except Exception as e:
                messagebox.showerror("エラー", f"フィルタ適用エラー: {str(e)}")
        
        ttk.Button(button_frame, text="✅ フィルタ適用", command=apply_filter, style='Action.TButton').pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="🔄 プレビュー更新", command=update_preview).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="❌ キャンセル", command=dialog.destroy).pack(side=tk.LEFT, padx=5)
    
