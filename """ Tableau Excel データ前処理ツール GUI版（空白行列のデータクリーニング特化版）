    # ===== 高度な文字列処理メソッド =====
    def advanced_string_cleaning(self, series):
        """より高度な文字列クリーニング（Excel特有の問題対応）"""
        try:
            cleaned = series.copy()
            
            for idx in cleaned.index:
                val = cleaned.loc[idx]
                if pd.notna(val):
                    str_val = str(val)
                    
                    # より包括的な空文字列パターンをチェック
                    patterns_to_check = [
                        '',                    # 空文字列
                        ' ',                   # 半角スペース
                        '　',                  # 全角スペース
                        '\t',                  # タブ
                        '\n',                  # 改行
                        '\r',                  # キャリッジリターン
                        '\u00A0',             # ノンブレーキングスペース
                        '\u2000',             # ENクワッド
                        '\u2001',             # EMクワッド
                        '\u2002',             # ENスペース
                        '\u2003',             # EMスペース
                        '\u2004',             # 1/3EMスペース
                        '\u2005',             # 1/4EMスペース
                        '\u2006',             # 1/6EMスペース
                        '\u2007',             # 数字スペース
                        '\u2008',             # 句読点スペース
                        '\u2009',             # 細いスペース
                        '\u200A',             # 極細スペース
                        '\u200B',             # ゼロ幅スペース
                        '\u200C',             # ゼロ幅非結合子
                        '\u200D',             # ゼロ幅結合子
                        '\u202F',             # 狭いノンブレーキングスペース
                        '\u205F',             # 中程度の数学スペース
                        '\u3000',             # 表意文字スペース
                        'nan', 'NaN', 'null', 'NULL', 'None', 'NONE',
                        '#N/A', '#REF!', '#VALUE!', '#DIV/0!', '#NAME?', '#NUM!', '#NULL!'
                    ]
                    
                    # 文字列を正規化してチェック
                    normalized_val = str_val.strip()
                    
                    # 空文字列パターンマッチ
                    if (normalized_val in patterns_to_check or 
                        not normalized_val or 
                        normalized_val.isspace() or
                        len(normalized_val.replace(' ', '').replace('　', '').replace('\t', '').replace('\n', '').replace('\r', '')) == 0):
                        cleaned.loc[idx] = np.nan
                    
                    # 数式エラーパターン
                    elif any(error in normalized_val for error in ['#N/A', '#REF!', '#VALUE!', '#DIV/0!', '#NAME?', '#NUM!', '#NULL!']):
                        cleaned.loc[idx] = np.nan
            
            return cleaned
        except Exception as e:
            print(f"WARNING: 高度文字列クリーニングエラー: {e}")
            return series
    
    def detect_empty_rows_advanced(self):
        """高度な空行検出"""
        try:
            empty_rows = []
            
            for idx in self.data.index:
                row_data = self.data.loc[idx]
                is_empty = True
                
                for col in self.data.columns:
                    val = row_data[col]
                    
                    # NaNチェック
                    if pd.notna(val):
                        # 数値の場合
                        if isinstance(val, (int, float)):
                            if not (np.isnan(val) if isinstance(val, float) else False):
                                is_empty = False
                                break
                        # 文字列の場合
                        else:
                            str_val = str(val).strip()
                            # より厳密な空文字列チェック
                            if (str_val and 
                                str_val not in ['', 'nan', 'NaN', 'null', 'NULL', 'None'] and
                                not str_val.isspace() and
                                not all(c in ' 　\t\n\r\u00A0\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200A\u200B\u200C\u200D\u202F\u205F\u3000' for c in str_val)):
                                is_empty = False
                                break
                
                if is_empty:
                    empty_rows.append(idx)
            
            return empty_rows
        except Exception as e:
            print(f"ERROR: 高度空行検出エラー: {e}")
            return []
    
