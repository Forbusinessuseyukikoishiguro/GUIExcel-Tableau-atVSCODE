        condition_combo.pack(side=tk.LEFT, padx=5)
        
        # 値入力
        value_frame = ttk.Frame(dialog)
        value_frame.pack(fill=tk.X, padx=20, pady=10)
        
        ttk.Label(value_frame, text="値:").pack(side=tk.LEFT)
