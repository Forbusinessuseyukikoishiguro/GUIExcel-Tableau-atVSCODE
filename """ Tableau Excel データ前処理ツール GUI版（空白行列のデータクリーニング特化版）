        report += f"💡 推奨クリーニングアクション（高度検出）:\n"
        report += "-" * 40 + "\n"
        
        actions = []
        if empty_row_indices:
            actions.append(f"1. 高度空行削除: {len(empty_row_indices)} 行を削除")
        if empty_columns:
            actions.append(f"2. 高度空列削除: {len(empty_columns)} 列を削除")
        if duplicates > 0:
            actions.append(f"3. 重複削除: {duplicates} 行を削除")
        if total_missing > 0:
            actions.append(f"4. 欠損値処理: {total_missing} 個を処理（平均値/削除）")
        
        if actions:
            for action in actions:
                report += f"  {action}\n"
            report += f"\n  👁️ 「空行列プレビュー」で詳細確認可能\n"
