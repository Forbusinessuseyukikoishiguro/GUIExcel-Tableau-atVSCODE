        report += f"日付列{len(self.data.select_dtypes(include=['datetime']).columns)}個\n\n"
        
        # 空行診断（高度版）
        report += f"🗑️ 空行診断（高度検出）:\n"
        report += "-" * 50 + "\n"
        
        empty_row_indices = self.detect_empty_rows_advanced()
        report += f"  • 高度検出による空行: {len(empty_row_indices)} 行\n"
        
        if empty_row_indices:
            removal_percentage = (len(empty_row_indices) / len(self.data)) * 100
            report += f"  • 削除率: {removal_percentage:.2f}%\n"
        else:
            report += f"  • ✅ 削除対象の空行はありません\n"
        
        report += "\n"
        
        # 空列診断（高度版）
        report += f"🗂️ 空列診断（高度検出）:\n"
        report += "-" * 60 + "\n"
        
        empty_columns = self.detect_empty_columns_advanced()
        
        if empty_columns:
            report += f"  削除対象の空列 ({len(empty_columns)} 列):\n"
            for col in empty_columns:
                col_data = self.data[col]
                data_type = str(col_data.dtype)
                report += f"    • {col[:30]:<30} | {data_type:<10}\n"
        else:
            report += f"  ✅ 削除対象の空列はありません\n"
        
        report += "\n"
        
        # 重複行診断
        duplicates = self.data.duplicated().sum()
        report += f"👥 重複診断:\n"
        report += f"  • 重複行数: {duplicates:,} 行\n"
        if duplicates > 0:
            duplicate_percentage = (duplicates / len(self.data)) * 100
            report += f"  • 重複率: {duplicate_percentage:.2f}%\n"
        report += "\n"
        
        # 欠損値診断
        total_missing = self.data.isnull().sum().sum()
        report += f"❓ 欠損値診断:\n"
        report += f"  • 総欠損値: {total_missing:,} 個\n"
        if total_missing > 0:
            missing_percentage = (total_missing / (self.data.shape[0] * self.data.shape[1])) * 100
            report += f"  • 欠損率: {missing_percentage:.2f}%\n"
            
            # 欠損値が多い列トップ5
            missing_by_col = self.data.isnull().sum().sort_values(ascending=False)
            top_missing = missing_by_col.head(5)
            top_missing = top_missing[top_missing > 0]
            
            if len(top_missing) > 0:
                report += f"  • 欠損値上位列:\n"
                for col, missing_count in top_missing.items():
                    missing_rate = (missing_count / len(self.data)) * 100
                    report += f"    - {col[:25]:<25} | {missing_count:>6} 個 ({missing_rate:>5.1f}%)\n"
        
        report += "\n"
        
        # データ品質スコア
        report += f"⭐ データ品質スコア:\n"
        report += "-" * 30 + "\n"
        
        # スコア計算（100点満点）
        quality_score = 100
        
        # 空行・空列の影響
        if empty_row_indices:
            empty_penalty = min(20, (len(empty_row_indices) / len(self.data)) * 100)
            quality_score -= empty_penalty
            
        # 重複の影響  
        if duplicates > 0:
            duplicate_penalty = min(15, (duplicates / len(self.data)) * 50)
            quality_score -= duplicate_penalty
            
        # 欠損値の影響
        if total_missing > 0:
            missing_percentage = (total_missing / (self.data.shape[0] * self.data.shape[1])) * 100
            missing_penalty = min(25, missing_percentage)
            quality_score -= missing_penalty
        
        quality_score = max(0, quality_score)
        
        if quality_score >= 90:
            quality_status = "優秀 ✅"
        elif quality_score >= 70:
            quality_status = "良好 👍"
        elif quality_score >= 50:
            quality_status = "普通 ⚠️"
        else:
            quality_status = "要改善 🔴"
        
        report += f"  • 総合スコア: {quality_score:.1f}/100 ({quality_status})\n\n"
        
