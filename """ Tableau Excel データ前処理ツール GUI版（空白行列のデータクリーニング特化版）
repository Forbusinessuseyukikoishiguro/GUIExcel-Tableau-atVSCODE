        """データ診断レポートを生成"""
        report = "🔍 データ診断レポート\n"
        report += "=" * 80 + "\n\n"
        
        # 基本情報
        report += f"📊 基本情報:\n"
        report += f"  • データサイズ: {self.data.shape[0]:,} 行 × {self.data.shape[1]} 列\n"
        report += f"  • データ型: 数値列{len(self.data.select_dtypes(include=[np.number]).columns)}個, "
