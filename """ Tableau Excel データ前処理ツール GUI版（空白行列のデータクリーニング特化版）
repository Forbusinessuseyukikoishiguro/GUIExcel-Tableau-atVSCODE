    def analyze_empty_reason_row(self, row_data):
        """空行の理由を分析"""
        nan_count = row_data.isna().sum()
        total_cols = len(row_data)
        
        if nan_count == total_cols:
            return "完全NaN"
        elif nan_count > total_cols * 0.8:
            return "ほぼNaN"
        else:
            # 非NaNの値をチェック
            non_nan_vals = row_data.dropna()
            if len(non_nan_vals) == 0:
                return "すべて空"
            
            # 空文字列・スペースのみかチェック
            empty_like_count = 0
            for val in non_nan_vals:
                str_val = str(val).strip()
                if not str_val or str_val.isspace():
                    empty_like_count += 1
            
            if empty_like_count == len(non_nan_vals):
                return "空文字・スペース"
            else:
                return "特殊パターン"
    
    def analyze_empty_reason_column(self, col_data):
        """空列の理由を分析"""
        nan_count = col_data.isna().sum()
        total_rows = len(col_data)
        
        if nan_count == total_rows:
            return "完全NaN"
        elif nan_count > total_rows * 0.95:
            return "ほぼNaN"
        else:
            # 非NaNの値をチェック
            non_nan_vals = col_data.dropna()
            if len(non_nan_vals) == 0:
                return "すべて空"
            
            # 空文字列・スペースのみかチェック
            empty_like_count = 0
            for val in non_nan_vals:
                str_val = str(val).strip()
                if not str_val or str_val.isspace():
                    empty_like_count += 1
            
            if empty_like_count == len(non_nan_vals):
                return "空文字・スペース"
            else:
                return "特殊パターン"
    
    def generate_empty_detailed_analysis(self):
        """空行列の詳細分析レポートを生成"""
        analysis = "📋 空行列詳細分析レポート\n"
        analysis += "=" * 60 + "\n\n"
        
        # 空行分析
        empty_row_indices = self.detect_empty_rows_advanced()
        analysis += f"🗑️ 空行詳細分析:\n"
        analysis += f"  • 検出空行数: {len(empty_row_indices)} 行\n"
        
        if empty_row_indices:
            # パターン別分析
            pattern_counts = {}
            for idx in empty_row_indices[:50]:  # 最初の50行を分析
                row_data = self.data.iloc[idx]
                reason = self.analyze_empty_reason_row(row_data)
                pattern_counts[reason] = pattern_counts.get(reason, 0) + 1
            
            analysis += f"  • パターン別内訳:\n"
            for pattern, count in pattern_counts.items():
                analysis += f"    - {pattern}: {count} 行\n"
        
        analysis += "\n"
        
        # 空列分析
        empty_columns = self.detect_empty_columns_advanced()
        analysis += f"🗂️ 空列詳細分析:\n"
        analysis += f"  • 検出空列数: {len(empty_columns)} 列\n"
        
        if empty_columns:
            # データ型別分析
            type_counts = {}
            for col in empty_columns:
                dtype = str(self.data[col].dtype)
                type_counts[dtype] = type_counts.get(dtype, 0) + 1
            
            analysis += f"  • データ型別内訳:\n"
            for dtype, count in type_counts.items():
                analysis += f"    - {dtype}: {count} 列\n"
            
            analysis += f"  • 削除対象列一覧:\n"
            for col in empty_columns:
                analysis += f"    - {col}\n"
        
        analysis += "\n"
        
        # 推奨アクション
        analysis += f"💡 推奨アクション:\n"
        if empty_row_indices or empty_columns:
            if empty_row_indices:
                analysis += f"  1. {len(empty_row_indices)} 行の空行を削除\n"
            if empty_columns:
                analysis += f"  2. {len(empty_columns)} 列の空列を削除\n"
            
            reduction_estimate = len(empty_row_indices) / len(self.data) * 100
            analysis += f"  3. データサイズ削減予想: 約{reduction_estimate:.1f}%\n"
        else:
            analysis += f"  ✅ 削除対象なし。データはクリーンです。\n"
        
        return analysis
    
    def auto_clean_data(self, parent_window=None):
        """自動クリーニングを実行"""
        if self.data is None:
            messagebox.showwarning("データなし", "データが読み込まれていません。")
            return
        
        try:
            # 確認ダイアログ
            result = messagebox.askyesno(
                "自動クリーニング確認",
                "以下の処理を自動実行します：\n\n"
                "1. 高度空行削除\n"
                "2. 高度空列削除\n"
                "3. 重複行削除\n"
                "4. テキストデータクリーニング\n\n"
                "実行しますか？"
            )
            
            if not result:
                return
            
            initial_shape = self.data.shape
            
            # 1. 空行削除
            empty_rows = self.detect_empty_rows_advanced()
            if empty_rows:
                self.data = self.data.drop(empty_rows)
                self.data = self.data.reset_index(drop=True)
                self.log_action(f"自動クリーニング: {len(empty_rows)}行の空行を削除")
            
            # 2. 空列削除
            empty_cols = self.detect_empty_columns_advanced()
            if empty_cols:
                self.data = self.data.drop(columns=empty_cols)
                self.log_action(f"自動クリーニング: {len(empty_cols)}列の空列を削除")
            
            # 3. 重複行削除
            initial_rows = len(self.data)
            self.data = self.data.drop_duplicates()
            duplicates_removed = initial_rows - len(self.data)
            if duplicates_removed > 0:
                self.log_action(f"自動クリーニング: {duplicates_removed}行の重複を削除")
            
            # 4. テキストクリーニング
            text_columns = self.data.select_dtypes(include=['object']).columns
            for col in text_columns:
                self.data[col] = self.data[col].astype(str).str.strip()
                self.data[col] = self.data[col].str.replace(r'\s+', ' ', regex=True)
            
            final_shape = self.data.shape
            
            # GUI更新
            self.update_data_info()
            self.update_data_table()
            
            # 結果報告
            total_rows_removed = initial_shape[0] - final_shape[0]
            total_cols_removed = initial_shape[1] - final_shape[1]
            
            success_msg = f"🎉 自動クリーニング完了！\n\n"
            success_msg += f"📊 処理前: {initial_shape[0]:,} 行 × {initial_shape[1]} 列\n"
            success_msg += f"📊 処理後: {final_shape[0]:,} 行 × {final_shape[1]} 列\n"
            success_msg += f"🔥 削除: {total_rows_removed:,} 行, {total_cols_removed} 列\n\n"
            success_msg += f"実行した処理:\n"
            success_msg += f"• 空行削除: {len(empty_rows)} 行\n"
            success_msg += f"• 空列削除: {len(empty_cols)} 列\n"
            success_msg += f"• 重複削除: {duplicates_removed} 行\n"
            success_msg += f"• テキスト整形: {len(text_columns)} 列"
            
            messagebox.showinfo("自動クリーニング完了", success_msg)
            
            self.update_status(f"✅ 自動クリーニング完了 ({final_shape[0]}行 × {final_shape[1]}列)")
            
            # 親ウィンドウを閉じる
            if parent_window:
                parent_window.destroy()
                
        except Exception as e:
            self.show_error(f"自動クリーニングエラー: {str(e)}")
    
