                    'zero': 'ゼロ補完',
                    'custom': 'カスタム値補完'
                }
                
                self.log_action(f"欠損値処理: {processed_count}個処理 (方法: {method_names.get(method, method)})")
                self.update_status(f"✅ {processed_count}個の欠損値を処理しました ({method_names.get(method, method)})")
                
