    def export_to_excel(self, file_path):
        """Excelファイルにエクスポート"""
        try:
            with pd.ExcelWriter(file_path, engine='openpyxl') as writer:
                # メインデータ
                self.data.to_excel(writer, sheet_name='データ', index=False)
                
                # 処理サマリー（オプション）
                if self.include_summary.get():
                    summary_data = self.generate_summary_data()
                    summary_df = pd.DataFrame(list(summary_data.items()), columns=['項目', '値'])
                    summary_df.to_excel(writer, sheet_name='処理サマリー', index=False)
                
                # 処理ログ（オプション）
                if self.include_log.get() and self.processing_log:
                    log_df = pd.DataFrame(self.processing_log, columns=['処理ログ'])
                    log_df.to_excel(writer, sheet_name='処理ログ', index=False)
            
            self.log_action(f"Excelエクスポート: {file_path}")
            
            success_msg = f"✅ Excelファイルの保存が完了しました！\n\n"
            success_msg += f"📁 保存先: {file_path}\n"
            success_msg += f"📊 データサイズ: {self.data.shape[0]:,} 行 × {self.data.shape[1]} 列\n"
            success_msg += f"📋 シート数: "
            
            sheet_count = 1
            if self.include_summary.get():
                sheet_count += 1
            if self.include_log.get() and self.processing_log:
                sheet_count += 1
            
            success_msg += f"{sheet_count} シート"
            
            messagebox.showinfo("Excel保存完了", success_msg)
            self.update_status("✅ Excelファイル保存完了")
            
        except Exception as e:
            raise Exception(f"Excelファイルの保存に失敗しました: {str(e)}")
    
    def export_to_csv(self, file_path):
        """CSVファイルにエクスポート"""
        try:
            # メインデータをCSV保存
            self.data.to_csv(file_path, index=False, encoding='utf-8-sig')
            
            # 追加ファイル保存（オプション）
            base_path = os.path.splitext(file_path)[0]
            
            if self.include_summary.get():
                summary_data = self.generate_summary_data()
                summary_df = pd.DataFrame(list(summary_data.items()), columns=['項目', '値'])
                summary_path = f"{base_path}_サマリー.csv"
                summary_df.to_csv(summary_path, index=False, encoding='utf-8-sig')
            
            if self.include_log.get() and self.processing_log:
                log_df = pd.DataFrame(self.processing_log, columns=['処理ログ'])
                log_path = f"{base_path}_ログ.csv"
                log_df.to_csv(log_path, index=False, encoding='utf-8-sig')
            
            self.log_action(f"CSVエクスポート: {file_path}")
            
            success_msg = f"✅ CSVファイルの保存が完了しました！\n\n"
            success_msg += f"📁 保存先: {file_path}\n"
            success_msg += f"📊 データサイズ: {self.data.shape[0]:,} 行 × {self.data.shape[1]} 列\n"
            success_msg += f"📄 エンコーディング: UTF-8 (BOM付き)\n"
            
            file_count = 1
            if self.include_summary.get():
                file_count += 1
            if self.include_log.get() and self.processing_log:
                file_count += 1
            
            success_msg += f"📋 保存ファイル数: {file_count} ファイル"
            
            messagebox.showinfo("CSV保存完了", success_msg)
            self.update_status("✅ CSVファイル保存完了")
            
        except Exception as e:
            raise Exception(f"CSVファイルの保存に失敗しました: {str(e)}")
    
    def generate_summary_data(self):
        """処理サマリーデータを生成"""
        summary = {
            '処理日時': datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            'データサイズ（行）': f"{self.data.shape[0]:,}",
            'データサイズ（列）': f"{self.data.shape[1]}",
            '元ファイル': os.path.basename(self.file_path) if self.file_path else "サンプルデータ",
            '処理回数': f"{len(self.processing_log)}",
            '空セル数': f"{self.data.isnull().sum().sum():,}",
            '重複行数': f"{self.data.duplicated().sum():,}",
            'データ型': f"数値列{len(self.data.select_dtypes(include=[np.number]).columns)}個, 文字列列{len(self.data.select_dtypes(include=['object']).columns)}個"
        }
        
        return summary
    
    def reset_data(self):
        """データをリセット"""
        if self.original_data is not None:
            result = messagebox.askyesno("データリセット", "データを元の状態に戻しますか？\n現在の変更は失われます。")
            
            if result:
                self.data = self.original_data.copy()
                
                self.update_data_info()
                self.update_data_table()
                
                self.log_action("データリセット: 元の状態に復元")
                self.update_status("✅ データを元の状態にリセットしました")
                
                messagebox.showinfo("リセット完了", "データを元の状態に戻しました。")
        else:
            messagebox.showinfo("情報", "リセット可能な元データがありません。")
    
    def show_processing_log(self):
        """処理ログを表示"""
        if not self.processing_log:
            messagebox.showinfo("ログなし", "実行された処理がありません。")
            return
        
        # ログウィンドウ作成
        log_window = tk.Toplevel(self.root)
        log_window.title("📋 処理ログ")
        log_window.geometry("800x600")
        log_window.transient(self.root)
        
        # スクロール可能なテキストエリア
        text_widget = scrolledtext.ScrolledText(log_window, wrap=tk.WORD, 
                                               font=('Consolas', 10), bg='#f8f8f8')
        text_widget.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        
        # ログを表示
        log_content = "📋 処理ログ\n"
        log_content += "=" * 60 + "\n\n"
        
        for i, log_entry in enumerate(self.processing_log, 1):
            log_content += f"{i:3d}. {log_entry}\n"
        
        log_content += "\n" + "=" * 60 + "\n"
        log_content += f"総処理数: {len(self.processing_log)} 件\n"
        log_content += f"現在のデータ: {self.data.shape[0]:,} 行 × {self.data.shape[1]} 列\n" if self.data is not None else "現在のデータ: なし\n"
        
        text_widget.insert(tk.END, log_content)
        text_widget.config(state='disabled')
        
        # ボタンフレーム
        button_frame = ttk.Frame(log_window)
        button_frame.pack(pady=10)
        
        def export_log():
            file_path = filedialog.asksaveasfilename(
                title="ログをテキストファイルで保存",
                defaultextension=".txt",
                filetypes=[("Text files", "*.txt"), ("All files", "*.*")]
            )
            
            if file_path:
                with open(file_path, 'w', encoding='utf-8') as f:
                    f.write(log_content)
                messagebox.showinfo("保存完了", f"ログを保存しました:\n{file_path}")
        
        ttk.Button(button_frame, text="💾 ログを保存", command=export_log).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="閉じる", command=log_window.destroy).pack(side=tk.LEFT, padx=5)


